# AIO-GI environment variables
# Copy to .env.local for local development. Replace example values with your own.
# Never commit .env.local or service account private keys.

# Firebase client SDK: use the exact values from Firebase Console > Project settings.
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_actual_storage_bucket
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK: set all three below, OR use Application Default Credentials.
# If using ADC, remove/comment these three placeholder assignments after copying.
# A key file placed in secret/ is not read automatically by this application.
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=your_service_account@your_project_id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"

# Optional: Realtime Database, for features that use it.
# FIREBASE_DATABASE_URL=https://your_database_url
# NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_database_url

# CPX conversation and voice features.
OPENAI_API_KEY=sk-your_openai_api_key
# Chat model is set in app/api/cpx/chat/route.ts (currently gpt-6-luna).
CPX_CHAT_MAX_TOKENS=2048
CPX_STT_MODEL=gpt-4o-mini-transcribe
CPX_TTS_MODEL=gpt-4o-mini-tts
CPX_TTS_VOICE=cedar
CPX_TTS_SPEED=1.3
# CPX_TTS_INSTRUCTIONS=Speak in a calm voice.

# EMT / EMT-L analysis service base URL; used by lib/emt-analysis.ts.
# EMT_ANALYSIS_SERVICE_URL=https://your-service-url.asia-northeast3.run.app
# FIREBASE_STORAGE_BUCKET=your_actual_storage_bucket

# Email sending (Gmail SMTP).
# GMAIL_USER=your_email@gmail.com
# GMAIL_APP_PASSWORD=your_app_password
# ADMIN_EMAIL=your_admin_email@example.com

# Optional Bearer token shared by the cleanup API and Cloud Scheduler job.
# CLEANUP_SECRET_TOKEN=your_secret_token
